{
  "$schema": "https://api.stryker-mutator.io/component-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "buildCommand": "npx nuxi prepare",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": ["app/components/TheHeader.vue", "app/components/TheFooter.vue", "app/error.vue"],
  "ignorePatterns": ["dist", "node_modules", ".stryker-tmp", "coverage"],
  "thresholds": {
    "high": 100,
    "low": 80,
    "break": 100
  },
  "concurrency": 2,
  "timeoutMS": 30000,
  "maxTestRunnerReuse": 3,
  "cleanTempDir": true
}
