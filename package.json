{
  "name": "piano-louvorja-site",
  "version": "1.0.0",
  "description": "PIANO LouvorJA — Landing page do gerenciador de cultos web",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "Equipe LouvorJA",
  "repository": {
    "type": "git",
    "url": "https://github.com/pianolouvorja/site.git"
  },
  "homepage": "https://pianolouvorja.com.br",
  "bugs": {
    "url": "https://github.com/pianolouvorja/site/issues"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "test:mutation": "stryker run",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run --coverage && playwright test",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.5.0",
    "@tabler/icons-webfont": "^3.46.0",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.54.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/vue3": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.100.0",
    "storybook": "^8.6.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
